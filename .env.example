# Conexion a Base de Datos PostgreSQL Serverless en Neon (Si no se modifica, usa SQLite local)
DATABASE_URL=sqlite:///./bodegacontrol_local.db
# Ejemplo Neon DB: DATABASE_URL=postgresql+psycopg2://user:pass@ep-chanita-123.us-east-2.aws.neon.tech/bodegadb?sslmode=require

# Seguridad y Cifrado JWT (RF01 / RNF04)
SECRET_KEY=bodega_chanita_secret_key_hex_2026_unam_episi_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Reglas de Negocio Parametrizadas (SRS 1 - Seccion 10)
MAX_CREDIT_LIMIT_DEFAULT=100.00
MAX_OVERDUE_DAYS=30
MIN_PROFIT_MARGIN=0.20
